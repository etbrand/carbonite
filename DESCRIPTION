URL: https://github.com/etbrand/carbonite
BugReports: https://github.com/etbrand/carbonite/issues
Depends:
    R (>= 4.1.0)
Imports:
    cli,
    htmltools (>= 0.5.2),
    rlang,
    shiny (>= 1.5.0),
    utils
Encoding: UTF-8
Suggests:
    testthat (>= 3.0.0)
